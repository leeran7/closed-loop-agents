# Closed-loop runtime (pack gitignore snippet)
# Ignore per-run artifacts. Re-include learnings.md (open questions only).
# Handoff JSONs are transient scratch — the orchestrator retro promotes
# their findings into docs/agents/skills, so nothing durable is lost by
# not tracking them.
loop/*
!loop/learnings.md
!loop/*.md
.cursor/loop/handoffs/*.json
.cursor/loop/state.json
.claude/handoffs/*.json

# Dependencies & build
node_modules/
dist/
*.log

# Environment
.env
.env.local
